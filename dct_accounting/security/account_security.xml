<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Odoo Community ships the full-accounting technical groups but keeps
            the Invoicing-only privilege hierarchy active. DCT exposes the
            documented Accountant level and makes Administrator inherit it.
        -->
        <record id="account.group_account_user" model="res.groups">
            <field name="name">Accountant</field>
            <field name="sequence">40</field>
            <field name="comment">Full accounting access except advanced configuration.</field>
            <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        </record>

        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
    </data>
</odoo>


