<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep the Community application on Odoo's native Accounting UI. -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
    </record>

    <!-- The standard journal dashboard stays the Accounting home screen. This
         client action exposes the complementary executive overview from the
         dashboard command bar and Reporting menu. -->
    <record id="action_dct_accounting_overview" model="ir.actions.client">
        <field name="name">Financial Overview</field>
        <field name="tag">dct_accounting.Dashboard</field>
        <field name="path">financial-overview</field>
    </record>
    <menuitem
        id="menu_dct_accounting_overview"
        name="Financial Overview"
        parent="account.account_reports_management_menu"
        action="action_dct_accounting_overview"
        sequence="5"
        groups="account.group_account_readonly"
    />

    <!-- Add semantic hooks and journal-type icons to the native dashboard.
         The journal data and all actions remain Odoo/OCA-owned. -->
    <record id="account_journal_dashboard_enterprise_style" model="ir.ui.view">
        <field name="name">account.journal.dashboard.enterprise.style</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account.account_journal_dashboard_kanban_view"
        />
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute
                    name="class"
                    add="dcta_enterprise_dashboard"
                    separator=" "
                />
            </xpath>
            <xpath expr="//t[@t-name='JournalTop']/span[1]" position="attributes">
                <attribute
                    name="class"
                    add="dcta_journal_card_header"
                    separator=" "
                />
            </xpath>
            <xpath expr="//t[@t-name='JournalTop']/span[1]/a[1]" position="before">
                <span
                    t-attf-class="dcta_journal_icon dcta_journal_icon_#{journal_type}"
                    aria-hidden="true"
                >
                    <i
                        t-if="journal_type == 'bank'"
                        class="fa fa-bank"
                        title="Bank journal"
                    />
                    <i
                        t-elif="journal_type == 'cash'"
                        class="fa fa-money"
                        title="Cash journal"
                    />
                    <i
                        t-elif="journal_type == 'credit'"
                        class="fa fa-credit-card"
                        title="Credit card journal"
                    />
                    <i
                        t-elif="journal_type == 'sale'"
                        class="fa fa-file-text-o"
                        title="Sales journal"
                    />
                    <i
                        t-elif="journal_type == 'purchase'"
                        class="fa fa-shopping-cart"
                        title="Purchase journal"
                    />
                    <i t-else="" class="fa fa-book" title="General journal" />
                </span>
            </xpath>
            <xpath
                expr="//t[@t-name='card']/div[contains(@t-att-class, 'container-fluid')]"
                position="attributes"
            >
                <attribute
                    name="class"
                    add="dcta_journal_card_body"
                    separator=" "
                />
            </xpath>
        </field>
    </record>

    <!-- Preserve historical XML IDs during upgrades without showing duplicate
         DCT dashboards or report entries. -->
    <record id="menu_dct_accounting_root" model="ir.ui.menu">
        <field name="name">DCT Accounting (Legacy)</field>
        <field name="active" eval="False"/>
    </record>
