    </record>

    <!-- Clean-room interactive reports with an Enterprise-style workflow. The
         legacy form actions above remain available as a safe fallback. -->
    <record id="action_dct_profit_loss_interactive" model="ir.actions.client">
        <field name="name">Profit &amp; Loss</field>
        <field name="tag">dct_accounting.report</field>
        <field name="target">current</field>
        <field name="context">{'report_type': 'profit_loss'}</field>
