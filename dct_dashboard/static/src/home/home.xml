<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dct_dashboard.Home">
        <main class="o_dct_home">
            <section class="o_dct_apps_section" aria-label="Applications">
                <div t-if="allApps.length" class="o_dct_apps_grid">
                    <button type="button"
                            class="o_dct_app_card"
                            t-foreach="allApps"
                            t-as="app"
                            t-key="app.id"
                            t-att-data-menu-xmlid="app.xmlid"
                            t-att-title="app.name"
                            t-on-click="() => openApp(app)">
                        <span class="o_dct_app_icon_wrap">
                            <img t-if="app.webIconData" t-att-src="app.webIconData" alt=""/>
                            <span t-else="" class="o_dct_app_initials" t-esc="appInitials(app.name)"/>
                        </span>
                        <span class="o_dct_app_copy">
                            <strong t-esc="app.name"/>
                        </span>
                    </button>
                </div>

                <div t-else="" class="o_dct_apps_empty">
                    <i class="fa fa-th-large" title="No applications" aria-hidden="true"/>
                    <h3>No applications are available.</h3>
                </div>
            </section>
        </main>
    </t>
</templates>


