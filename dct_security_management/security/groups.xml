    <record id="group_readonly" model="res.groups"><field name="name">Read-only operations</field><field name="privilege_id" ref="security_privilege"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_supervisor" model="res.groups"><field name="name">Site Supervisor</field><field name="privilege_id" ref="security_privilege"/><field name="implied_ids" eval="[(4, ref('group_readonly'))]"/></record>
    <record id="group_manager" model="res.groups"><field name="name">Operations Manager</field><field name="privilege_id" ref="security_privilege"/><field name="implied_ids" eval="[(4, ref('group_readonly'))]"/></record>
    <record id="group_hr" model="res.groups"><field name="name">HR / Attendance Officer</field><field name="privilege_id" ref="security_privilege"/><field name="implied_ids" eval="[(4, ref('group_readonly'))]"/></record>
    <record id="group_finance" model="res.groups"><field name="name">Finance Officer</field><field name="privilege_id" ref="security_privilege"/><field name="implied_ids" eval="[(4, ref('group_readonly'))]"/></record>
</odoo>
