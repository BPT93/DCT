<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="dct_security_management.Dashboard">
        <div class="o_dct_security h-100 overflow-auto">
            <header class="dct_header"><div><h1>Security Operations</h1><p t-if="state.data"><t t-esc="state.data.company_name"/> · Reporting timezone: <t t-esc="state.data.timezone"/></p></div><button class="btn btn-light" t-on-click="refresh" t-att-disabled="state.loading"><i class="fa fa-refresh me-2"/>Refresh</button></header>
            <div class="dct_filters"><label>From <input type="date" class="form-control" t-model="state.date_start"/></label><label>Through <input type="date" class="form-control" t-model="state.date_end"/></label><label>Company <select class="form-select" t-model="state.company_id" t-on-change="changeCompany"><t t-if="state.data"><option t-foreach="state.data.companies" t-as="company" t-key="company.id" t-att-value="company.id"><t t-esc="company.name"/></option></t></select></label><label>Site <select class="form-select" t-model="state.site_id"><option value="">All permitted sites</option><t t-if="state.data"><option t-foreach="state.data.sites" t-as="site" t-key="site.id" t-att-value="site.id"><t t-esc="site.name"/></option></t></select></label><button class="btn btn-primary align-self-end" t-on-click="refresh" t-att-disabled="state.loading">Apply filters</button></div>
            <div t-if="state.error" role="alert" class="alert alert-danger"><t t-esc="state.error"/></div>
            <div t-if="state.loading" class="dct_empty" role="status">Loading operations…</div>
            <t t-if="state.data and !state.loading">
                <h2>Current operations</h2><div class="dct_cards"><t t-foreach="state.data.cards.filter(c => c.period_type === 'now')" t-as="card" t-key="card.key"><button class="dct_card" t-att-title="card.definition" t-on-click="() => this.openAction(card.action)"><span t-esc="card.title"/><strong t-esc="card.value"/><small t-esc="card.definition"/></button></t></div>
                <h2>Selected period</h2><p class="text-muted"><t t-esc="state.data.date_start"/> — <t t-esc="state.data.date_end"/>; shifts belong to their start date in the reporting timezone.</p><div class="dct_cards"><t t-foreach="state.data.cards.filter(c => c.period_type === 'period')" t-as="card" t-key="card.key"><button class="dct_card" t-att-title="card.definition" t-on-click="() => this.openAction(card.action)"><span t-esc="card.title"/><strong t-esc="card.value"/><small t-esc="card.definition"/></button></t></div>
                <div class="dct_sections"><section class="dct_panel"><h2>Staffing now</h2><div class="table-responsive"><table class="table"><thead><tr><th>Site</th><th>Required</th><th>Assigned</th><th>Present</th><th>Missing</th></tr></thead><tbody><tr t-foreach="state.data.staffing" t-as="row" t-key="row.id"><td><button class="btn btn-link p-0" t-on-click="() => this.openRecord('dct.security.site', row.id)" t-esc="row.name"/></td><td t-esc="row.required"/><td t-esc="row.assigned"/><td t-esc="row.present"/><td><span t-att-class="row.missing ? 'badge text-bg-danger' : 'badge text-bg-success'" t-esc="row.missing"/></td></tr></tbody></table><p t-if="!state.data.staffing.length" class="dct_empty">No sites are available in this scope.</p></div></section>
                <section class="dct_panel"><h2>Recent operational activities</h2><button class="dct_activity" t-foreach="state.data.recent" t-as="item" t-key="item.key" t-on-click="() => this.openRecord(item.model, item.id)"><strong t-esc="item.name"/><span t-esc="item.site"/><span class="badge text-bg-secondary" t-esc="item.state_label"/></button><p t-if="!state.data.recent.length" class="dct_empty">No operational activities to display.</p></section></div>
                <section class="dct_panel"><h2>Attendance trends — hours</h2><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Scheduled</th><th>Worked</th><th>Approved</th></tr></thead><tbody><tr t-foreach="state.data.trends" t-as="day" t-key="day.date"><td t-esc="day.date"/><td t-esc="formatHours(day.scheduled)"/><td t-esc="formatHours(day.worked)"/><td t-esc="formatHours(day.approved)"/></tr></tbody></table><p t-if="!state.data.trends.length" class="dct_empty">No published assignments start in this period.</p></div></section>
                <section t-if="state.data.finance.length" class="dct_panel"><h2>Posted customer invoices</h2><p>Net invoiced excludes tax. Outstanding includes unpaid tax. Refunds reduce both figures; amounts remain separate by currency. Cash received includes only reconciled posted bank transactions or settled payments dated in the period. Payroll estimates prorate approved worksheets by calendar days in the period. Estimated margin is net invoiced less these worksheet costs.</p><div class="dct_cards"><div class="dct_card" t-foreach="state.data.finance" t-as="money" t-key="money.currency"><span t-esc="money.currency"/><strong t-esc="formatAmount(money.net, money.currency_id)"/><small>Outstanding: <t t-esc="formatAmount(money.outstanding, money.currency_id)"/></small><small>Cash received: <t t-esc="formatAmount(money.cash_received, money.currency_id)"/></small><small>Estimated payroll costs: <t t-esc="formatAmount(money.estimated_cost, money.currency_id)"/></small><small>Estimated margin: <t t-esc="formatAmount(money.estimated_margin, money.currency_id)"/></small><small t-if="money.site_partial">Site invoice and cash figures are proportional to service subtotals. Payroll costs are estimated using the site share of base compensation; unallocated costs are excluded.</small><div class="d-flex flex-wrap gap-2"><button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openAction(money.action)">Invoices</button><button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openAction(money.cash_action)">Cash sources</button><button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openAction(money.cost_action)">Cost sources</button></div></div></div></section>
                <p class="text-muted mt-3">Refreshed at <t t-esc="state.data.generated_at"/> UTC. All figures follow your record access.</p>
            </t>
        </div>
    </t>
    <t t-name="dct_security_management.WeeklyBoard">
        <div class="o_dct_security h-100 overflow-auto"><header class="dct_header"><div><h1>Weekly Guard Schedule</h1><p>Open a shift to edit assignments. Use an empty cell to create a draft shift.</p></div><button class="btn btn-light" t-on-click="refresh" t-att-disabled="state.loading">Refresh</button></header><div class="dct_filters"><button class="btn btn-secondary" t-on-click="previous">Previous</button><label>Week containing <input class="form-control" type="date" t-model="state.date_start"/></label><button class="btn btn-secondary" t-on-click="next">Next</button><label>Site <select class="form-select" t-model="state.site_id"><option value="">All permitted sites</option><t t-if="state.data"><option t-foreach="state.data.sites" t-as="site" t-key="site.id" t-att-value="site.id"><t t-esc="site.name"/></option></t></select></label><button class="btn btn-primary" t-on-click="refresh">Apply</button><button t-if="state.data" class="btn btn-outline-danger" t-on-click="() => this.openAction(state.data.shortage_action)">Review shortages</button></div>
            <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/><div t-if="state.loading" class="dct_empty" role="status">Loading schedule…</div><t t-if="state.data and !state.loading"><p class="text-muted">Timezone: <t t-esc="state.data.timezone"/>. Overnight assignments appear on each covered day; their full start and end are shown.</p><div t-if="state.data.truncated" class="alert alert-warning">The board is limited to 150 guards and 1,000 assignments. Narrow the site filter or use the native assignment list.</div><div class="table-responsive dct_panel"><table class="table dct_week"><thead><tr><th>Guard</th><th t-foreach="state.data.days" t-as="day" t-key="day" t-esc="day"/></tr></thead><tbody><tr t-foreach="state.data.rows" t-as="guard" t-key="guard.id"><th><button class="btn btn-link" t-on-click="() => this.openRecord('hr.employee',guard.id)" t-esc="guard.name"/></th><td t-foreach="guard.days" t-as="items" t-key="items_index"><button t-foreach="items" t-as="item" t-key="item.id" t-att-class="'dct_shift ' + (item.warning ? 'dct_warning' : '')" t-on-click="() => this.openRecord('dct.security.shift',item.shift_id)"><strong t-esc="item.site"/><span dir="ltr" t-esc="item.time"/><small t-esc="item.state_label"/><i t-if="item.warning" class="fa fa-warning" title="Attendance or leave exception"/></button><button t-if="state.data.can_plan" class="btn btn-sm btn-outline-primary dct_add" t-on-click="() => this.addShift(guard,state.data.days[items_index])" title="Create draft shift">+</button></td></tr></tbody></table><p t-if="!state.data.rows.length" class="dct_empty">No guards are available in this scope. Create guards and authorize them for sites before planning.</p></div></t>
        </div>
    </t>
    <t t-name="dct_security_management.SiteMap">
        <div class="o_dct_security h-100 overflow-auto"><header class="dct_header"><div><h1>Security Sites</h1><p>Pins show fixed site coordinates and scheduled staffing, recorded by your operations team.</p></div><button class="btn btn-light" t-on-click="refresh">Refresh</button></header><div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/><div t-if="state.loading" class="dct_empty">Loading sites…</div><t t-if="state.data"><div t-if="!state.data.tile_url" class="alert alert-info">No map tile provider is configured. Use the site list below. An administrator can configure an HTTPS tile URL and attribution in Security Operations settings.</div><div t-if="state.tileError" class="alert alert-warning">Map tiles could not be loaded. The site list remains available.</div><div t-if="state.data.tile_url" t-ref="map" class="dct_map"/><section class="dct_panel mt-3"><h2>Site list</h2><div class="table-responsive"><table class="table"><thead><tr><th>Site</th><th>Latitude</th><th>Longitude</th><th>Required now</th><th>Assigned now</th></tr></thead><tbody><tr t-foreach="state.data.sites" t-as="site" t-key="site.id"><td><button class="btn btn-link p-0" t-on-click="() => this.openRecord('dct.security.site',site.id)" t-esc="site.name"/></td><td t-esc="site.latitude"/><td t-esc="site.longitude"/><td t-esc="site.required"/><td t-esc="site.assigned"/></tr></tbody></table><p t-if="!state.data.sites.length" class="dct_empty">No sites are available in your scope.</p></div></section><p class="text-muted">Staffing refreshed at <t t-esc="state.data.generated_at"/> UTC. Site coordinates are not live guard locations.</p></t></div>
    </t>
</templates>
