<odoo noupdate="1">
    <record id="demo_customer" model="res.partner"><field name="name">Fictional DCT Training Customer</field><field name="company_id" ref="base.main_company"/></record>
    <record id="demo_site" model="dct.security.site"><field name="name">Fictional Training Campus</field><field name="partner_id" ref="demo_customer"/><field name="company_id" ref="base.main_company"/><field name="tz">Asia/Baghdad</field><field name="instructions">Fictional demonstration data. Record all patrol results manually through the backend.</field></record>
    <record id="demo_post_gate" model="dct.security.post"><field name="name">Training Main Gate</field><field name="site_id" ref="demo_site"/><field name="company_id" ref="base.main_company"/></record>
    <record id="demo_post_reception" model="dct.security.post"><field name="name">Training Reception</field><field name="site_id" ref="demo_site"/><field name="company_id" ref="base.main_company"/></record>
    <record id="demo_guard_1" model="hr.employee"><field name="name">Fictional Guard A</field><field name="is_security_guard" eval="True"/><field name="guard_code">DEMO-DCT-001</field><field name="company_id" ref="base.main_company"/><field name="security_site_ids" eval="[(4, ref('demo_site'))]"/></record>
    <record id="demo_guard_2" model="hr.employee"><field name="name">Fictional Guard B</field><field name="is_security_guard" eval="True"/><field name="guard_code">DEMO-DCT-002</field><field name="company_id" ref="base.main_company"/><field name="security_site_ids" eval="[(4, ref('demo_site'))]"/></record>
    <record id="demo_day_template" model="dct.security.shift.template"><field name="name">Training Day Coverage</field><field name="site_id" ref="demo_site"/><field name="post_id" ref="demo_post_gate"/><field name="company_id" ref="base.main_company"/><field name="start_hour">8</field><field name="end_hour">20</field><field name="required_guards">2</field></record>
    <record id="demo_night_template" model="dct.security.shift.template"><field name="name">Training Night Coverage</field><field name="site_id" ref="demo_site"/><field name="post_id" ref="demo_post_gate"/><field name="company_id" ref="base.main_company"/><field name="start_hour">20</field><field name="end_hour">8</field><field name="required_guards">2</field></record>
    <record id="demo_incident_category" model="dct.security.incident.category"><field name="name">Training observation</field><field name="company_id" ref="base.main_company"/></record>
</odoo>
