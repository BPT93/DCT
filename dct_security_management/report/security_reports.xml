<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_security" model="report.paperformat"><field name="name">Security Operations A4</field><field name="format">A4</field><field name="orientation">Portrait</field><field name="margin_top">40</field><field name="margin_bottom">20</field><field name="margin_left">10</field><field name="margin_right">10</field><field name="header_spacing">32</field></record>
    <template id="report_metadata"><p><strong>Company: </strong><span t-field="o.company_id.name"/></p><p class="text-muted small">Generated: <span t-out="generated_at"/> (<span t-out="report_timezone"/>). Scope: selected records permitted for the printing user. Times use the reporting user's timezone.</p></template>
    <template id="coverage_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Daily Site Coverage</h2><t t-call="dct_security_management.report_metadata"/><h3><span t-field="o.site_id"/> / <span t-field="o.post_id"/></h3><p><span t-field="o.start"/> — <span t-field="o.end"/></p><p>Owning site date: <span t-field="o.local_date"/>; site timezone: <span t-field="o.site_id.tz"/>.</p><table class="table table-sm"><thead><tr><th>Required guards</th><th>Assigned</th><th>Uncovered</th><th>Status</th></tr></thead><tbody><tr><td><span t-field="o.required_guards"/></td><td><span t-field="o.assigned_guards"/></td><td><span t-field="o.missing_guards"/></td><td><span t-field="o.state"/></td></tr></tbody></table><table class="table table-sm"><thead><tr><th>Guard</th><th>Assignment</th><th>Attendance status</th></tr></thead><tbody><tr t-foreach="o.assignment_ids" t-as="a"><td><span t-field="a.employee_id"/></td><td><span t-field="a.state"/></td><td><span t-field="a.attendance_state"/></td></tr></tbody></table><p class="text-muted">Coverage reflects the current assignment records. Suspected absence requires review before payroll or billing consequences.</p></div></t></t></t></template>
    <template id="roster_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Guard Roster</h2><t t-call="dct_security_management.report_metadata"/><h3 t-field="o.employee_id"/><table class="table table-sm"><tbody><tr><th>Site / post</th><td><span t-field="o.site_id"/> / <span t-field="o.shift_id.post_id"/></td></tr><tr><th>Shift</th><td><span t-field="o.shift_id"/></td></tr><tr><th>Start</th><td><span t-field="o.start"/></td></tr><tr><th>End</th><td><span t-field="o.end"/></td></tr><tr><th>Owning site date</th><td><span t-field="o.shift_id.local_date"/></td></tr><tr><th>Scheduled hours</th><td><span t-field="o.scheduled_hours" t-options="{'widget':'float','precision':2}"/></td></tr><tr><th>Assignment status</th><td><span t-field="o.state"/></td></tr></tbody></table><p t-field="o.site_id.instructions"/></div></t></t></t></template>
    <template id="attendance_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Attendance and Overtime</h2><t t-call="dct_security_management.report_metadata"/><h3><span t-field="o.employee_id"/> — <span t-field="o.site_id"/></h3><p>Assignment period: <span t-field="o.start"/> — <span t-field="o.end"/>.</p><table class="table table-sm"><tbody><tr><th>Scheduled hours</th><td><span t-field="o.scheduled_hours" t-options="{'widget':'float','precision':2}"/></td></tr><tr><th>Worked hours</th><td><span t-field="o.worked_hours" t-options="{'widget':'float','precision':2}"/></td></tr><tr><th>Approved hours</th><td><span t-field="o.approved_hours" t-options="{'widget':'float','precision':2}"/></td></tr><tr><th>Proposed overtime hours</th><td><span t-field="o.proposed_overtime_hours" t-options="{'widget':'float','precision':2}"/></td></tr><tr><th>Approved overtime hours</th><td><span t-field="o.approved_overtime_hours" t-options="{'widget':'float','precision':2}"/></td></tr><tr><th>Lateness (minutes)</th><td><span t-field="o.lateness_minutes"/></td></tr><tr><th>Early departure (minutes)</th><td><span t-field="o.early_departure_minutes"/></td></tr><tr><th>Status</th><td><span t-field="o.attendance_state"/></td></tr></tbody></table><p class="text-muted">Source: native attendance intervals allocated to this assignment. Select the month in the assignment list before printing a monthly selection. Native attendance overtime is not added again.</p></div></t></t></t></template>
    <template id="incident_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Incident <span t-field="o.name"/></h2><t t-call="dct_security_management.report_metadata"/><table class="table table-sm"><tbody><tr><th>Site / post</th><td><span t-field="o.site_id"/> / <span t-field="o.post_id"/></td></tr><tr><th>Occurred / reported</th><td><span t-field="o.occurred_at"/> / <span t-field="o.reported_at"/></td></tr><tr><th>Category / severity</th><td><span t-field="o.category_id"/> / <span t-field="o.severity"/></td></tr><tr><th>Investigator / deadline</th><td><span t-field="o.investigator_id"/> / <span t-field="o.deadline"/></td></tr><tr><th>State</th><td><span t-field="o.state"/></td></tr></tbody></table><h4>Description</h4><p t-field="o.description"/><h4>Corrective actions</h4><p t-field="o.corrective_actions"/><h4>Resolution</h4><p t-field="o.resolution"/></div></t></t></t></template>
    <template id="patrol_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Patrol Completion <span t-field="o.name"/></h2><t t-call="dct_security_management.report_metadata"/><p><span t-field="o.site_id"/> / <span t-field="o.employee_id"/></p><p>Planned: <span t-field="o.planned_start"/> — <span t-field="o.planned_end"/>. Actual: <span t-field="o.actual_start"/> — <span t-field="o.actual_end"/>.</p><p>Completed checkpoints: <span t-field="o.completion_percent" t-options="{'widget':'float','precision':1}"/>%. Pending / missed: <span t-field="o.missed_count"/>.</p><p t-field="o.instructions_snapshot"/><table class="table table-sm"><thead><tr><th>Checkpoint</th><th>Status</th><th>Completed at</th><th>Recorded by</th><th>Notes / exception</th></tr></thead><tbody><tr t-foreach="o.result_ids" t-as="r"><td><span t-field="r.name"/></td><td><span t-field="r.state"/></td><td><span t-field="r.completed_at"/></td><td><span t-field="r.actor_id"/><span t-field="r.exception_approved_by"/></td><td><span t-field="r.notes"/><span t-field="r.exception_reason"/></td></tr></tbody></table><p class="text-muted">All results are manual backend entries. No GPS verification or scanning is implied. Checkpoint details are historical snapshots taken when the round started.</p></div></t></t></t></template>
    <template id="visit_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Supervisor Visit <span t-field="o.name"/></h2><t t-call="dct_security_management.report_metadata"/><p><span t-field="o.site_id"/> / <span t-field="o.supervisor_id"/></p><p>Planned: <span t-field="o.planned_at"/>. Actual: <span t-field="o.actual_start"/> — <span t-field="o.actual_end"/>.</p><table class="table table-sm"><thead><tr><th>Inspection</th><th>Result</th><th>Findings</th><th>Recorded by</th></tr></thead><tbody><tr t-foreach="o.result_ids" t-as="r"><td><span t-field="r.name"/></td><td><span t-field="r.result"/></td><td><span t-field="r.notes"/></td><td><span t-field="r.actor_id"/></td></tr></tbody></table><h4>Findings</h4><p t-field="o.findings"/><h4>Follow-up actions</h4><p t-field="o.followup_actions"/><p>Related incident: <span t-field="o.incident_id"/></p><img t-if="o.photo" t-att-src="image_data_uri(o.photo)" style="max-width: 450px; max-height: 250px;"/></div></t></t></t></template>
    <template id="payroll_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Payroll Worksheet</h2><t t-call="dct_security_management.report_metadata"/><h3 t-field="o.employee_id"/><p>Period: <span t-field="o.date_start"/> — <span t-field="o.date_end"/>. Status: <span t-field="o.state"/>.</p><p>Approved hours: <span t-field="o.approved_hours" t-options="{'widget':'float','precision':2}"/></p><table class="table table-sm"><thead><tr><th>Component</th><th>Site</th><th>Quantity</th><th>Rate</th><th>Amount</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.name"/></td><td><span t-field="line.site_id"/></td><td><span t-field="line.quantity" t-options="{'widget':'float','precision':2}"/></td><td><span t-field="line.rate" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td><td><span t-field="line.amount" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr></tbody></table><table class="table table-sm"><tbody><tr><th>Gross base / overtime</th><td><span t-field="o.gross_amount"/></td></tr><tr><th>Allowances</th><td><span t-field="o.allowance_amount"/></td></tr><tr><th>Deductions</th><td><span t-field="o.deduction_amount"/></td></tr><tr><th>Net worksheet estimate</th><td><span t-field="o.net_amount"/></td></tr></tbody></table><p>Linked journal entry: <span t-field="o.move_id"/></p><p class="text-muted">Basic Community worksheet. Approval or a linked draft entry does not mark wages paid. Statutory taxes, contributions, and jurisdiction-specific compliance require separately configured localization.</p></div></t></t></t></template>
    <template id="billing_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Contract Billing</h2><t t-call="dct_security_management.report_metadata"/><h3 t-field="o.contract_id"/><p>Customer: <span t-field="o.contract_id.partner_id"/></p><p>Service period: <span t-field="o.date_start"/> — <span t-field="o.date_end"/>. Status: <span t-field="o.state"/>.</p><table class="table table-sm"><thead><tr><th>Service / site</th><th>Period</th><th>Quantity</th><th>Rate</th><th>Subtotal</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.name"/><br/><span t-field="line.site_id"/></td><td><span t-field="line.date_start"/> — <span t-field="line.date_end"/></td><td><span t-field="line.quantity" t-options="{'widget':'float','precision':2}"/></td><td><span t-field="line.rate" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td><td><span t-field="line.subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr></tbody></table><p>Untaxed service amount: <strong t-field="o.amount_total"/></p><p>Customer invoice: <span t-field="o.invoice_id"/></p><p class="text-muted">This service worksheet preserves the approved quantity and rate. The linked standard customer invoice is the accounting document. Draft invoices are not posted revenue or payment receipts.</p></div></t></t></t></template>

    <record id="report_coverage" model="ir.actions.report"><field name="name">Daily Site Coverage</field><field name="model">dct.security.shift</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.coverage_document</field><field name="binding_model_id" ref="model_dct_security_shift"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/></record>
    <record id="report_roster" model="ir.actions.report"><field name="name">Guard Roster</field><field name="model">dct.security.assignment</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.roster_document</field><field name="binding_model_id" ref="model_dct_security_assignment"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/></record>
    <record id="report_attendance" model="ir.actions.report"><field name="name">Monthly Attendance and Overtime</field><field name="model">dct.security.assignment</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.attendance_document</field><field name="binding_model_id" ref="model_dct_security_assignment"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/></record>
    <record id="report_incident" model="ir.actions.report"><field name="name">Incident Report</field><field name="model">dct.security.incident</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.incident_document</field><field name="binding_model_id" ref="model_dct_security_incident"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/></record>
    <record id="report_patrol" model="ir.actions.report"><field name="name">Patrol Completion</field><field name="model">dct.security.patrol.round</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.patrol_document</field><field name="binding_model_id" ref="model_dct_security_patrol_round"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/></record>
    <record id="report_visit" model="ir.actions.report"><field name="name">Supervisor Visits</field><field name="model">dct.security.visit</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.visit_document</field><field name="binding_model_id" ref="model_dct_security_visit"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/></record>
    <record id="report_payroll" model="ir.actions.report"><field name="name">Payroll Worksheet</field><field name="model">dct.security.payroll</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.payroll_document</field><field name="binding_model_id" ref="model_dct_security_payroll"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/><field name="group_ids" eval="[(4,ref('group_finance'))]"/></record>
    <record id="report_billing" model="ir.actions.report"><field name="name">Contract Billing</field><field name="model">dct.security.billing</field><field name="report_type">qweb-pdf</field><field name="report_name">dct_security_management.billing_document</field><field name="binding_model_id" ref="model_dct_security_billing"/><field name="binding_type">report</field><field name="paperformat_id" ref="paperformat_security"/><field name="group_ids" eval="[(4,ref('group_finance'))]"/></record>
</odoo>
