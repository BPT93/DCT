<odoo noupdate="1">
    <record id="sequence_incident" model="ir.sequence"><field name="name">Security incident</field><field name="code">dct.security.incident</field><field name="prefix">INC/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="sequence_patrol" model="ir.sequence"><field name="name">Security patrol</field><field name="code">dct.security.patrol.round</field><field name="prefix">PAT/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="sequence_visit" model="ir.sequence"><field name="name">Security visit</field><field name="code">dct.security.visit</field><field name="prefix">VIS/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="cron_security_operations" model="ir.cron"><field name="name">DCT Security: draft rosters and operational reminders</field><field name="model_id" ref="model_dct_security_site"/><field name="state">code</field><field name="code">model._cron_security_operations()</field><field name="interval_number">1</field><field name="interval_type">hours</field><field name="active" eval="True"/></record>
</odoo>
