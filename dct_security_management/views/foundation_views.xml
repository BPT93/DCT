<odoo>
    <record id="view_site_search" model="ir.ui.view"><field name="name">dct.security.site.search</field><field name="model">dct.security.site</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="supervisor_ids"/><filter name="operating" string="Operating" domain="[('state','=','active')]"/><filter name="mine" string="My Sites" domain="[('supervisor_ids','in',[uid])]"/><filter name="company" string="Company" context="{'group_by':'company_id'}"/></search></field></record>
    <record id="view_site_list" model="ir.ui.view"><field name="name">dct.security.site.list</field><field name="model">dct.security.site</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="city"/><field name="supervisor_ids" widget="many2many_tags"/><field name="required_count"/><field name="assigned_count"/><field name="present_count"/><field name="missing_count" decoration-danger="missing_count &gt; 0"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_site_form" model="ir.ui.view"><field name="name">dct.security.site.form</field><field name="model">dct.security.site</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_shifts" type="object" class="oe_stat_button" icon="fa-calendar" string="Shifts"/><button name="action_contracts" type="object" class="oe_stat_button" icon="fa-file-text" string="Contracts"/><button name="action_incidents" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" string="Incidents"/><button name="action_patrols" type="object" class="oe_stat_button" icon="fa-road" string="Patrols"/><button name="action_visits" type="object" class="oe_stat_button" icon="fa-check-square-o" string="Visits"/></div><field name="image_1920" widget="image" class="oe_avatar"/><h1><field name="name" placeholder="Site name"/></h1><group><group><field name="partner_id"/><field name="company_id" groups="base.group_multi_company"/><field name="state"/><field name="active" invisible="1"/><field name="supervisor_ids" widget="many2many_tags"/></group><group><field name="street"/><field name="street2"/><field name="city"/><field name="country_id"/><field name="tz"/><field name="has_coordinates"/><field name="latitude" invisible="not has_coordinates"/><field name="longitude" invisible="not has_coordinates"/></group></group><group string="Current coverage"><field name="required_count"/><field name="assigned_count"/><field name="present_count"/><field name="missing_count"/></group><notebook><page string="Posts"><field name="post_ids" context="{'default_company_id':company_id}"><list editable="bottom"><field name="name"/><field name="instructions"/><field name="active"/></list></field></page><page string="Instructions"><field name="instructions"/><field name="contact_ids" widget="many2many_tags"/></page><page string="Authorized guards"><field name="guard_ids" widget="many2many_tags" domain="[('is_security_guard','=',True),('company_id','=',company_id)]"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_site" model="ir.actions.act_window"><field name="name">Sites</field><field name="res_model">dct.security.site</field><field name="view_mode">list,form</field></record>
    <record id="view_post_list" model="ir.ui.view"><field name="name">dct.security.post.list</field><field name="model">dct.security.post</field><field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="instructions"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_post_form" model="ir.ui.view"><field name="name">dct.security.post.form</field><field name="model">dct.security.post</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="site_id"/><field name="company_id"/><field name="active"/><field name="instructions"/></group></sheet></form></field></record>
    <record id="action_post" model="ir.actions.act_window"><field name="name">Posts</field><field name="res_model">dct.security.post</field><field name="view_mode">list,form</field></record>
    <record id="view_guard_search" model="ir.ui.view"><field name="name">dct.guard.search</field><field name="model">hr.employee</field><field name="arch" type="xml"><search><field name="name"/><field name="guard_code"/><field name="security_site_ids"/><filter name="eligible" string="Eligible" domain="[('security_eligible','=',True)]"/><filter name="ineligible" string="Ineligible" domain="[('security_eligible','=',False)]"/><filter name="site" string="Site" context="{'group_by':'security_site_ids'}"/><filter name="supervisor" string="Supervisor" context="{'group_by':'security_supervisor_id'}"/></search></field></record>
    <record id="view_guard_list" model="ir.ui.view"><field name="name">dct.guard.list</field><field name="model">hr.employee</field><field name="arch" type="xml"><list><field name="guard_code"/><field name="name"/><field name="security_rank"/><field name="security_supervisor_id"/><field name="security_site_ids" widget="many2many_tags"/><field name="security_eligible"/><field name="security_status" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_guard_kanban" model="ir.ui.view"><field name="name">dct.guard.kanban</field><field name="model">hr.employee</field><field name="arch" type="xml"><kanban><field name="name"/><field name="guard_code"/><field name="security_status"/><templates><t t-name="card"><div class="d-flex gap-3"><field name="image_128" widget="image" options="{'size':[64,64]}"/><div><strong><field name="name"/></strong><div><field name="guard_code"/></div><field name="security_status" widget="badge"/></div></div></t></templates></kanban></field></record>
    <record id="view_guard_form" model="ir.ui.view"><field name="name">dct.guard.form</field><field name="model">hr.employee</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_security_assignments" type="object" class="oe_stat_button" icon="fa-calendar" string="Assignments"/><button name="action_security_attendance" type="object" class="oe_stat_button" icon="fa-clock-o" string="Attendance"/><button name="action_security_incidents" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" string="Incidents"/><button name="action_security_patrols" type="object" class="oe_stat_button" icon="fa-road" string="Patrols"/><button name="action_security_payroll" type="object" class="oe_stat_button" icon="fa-money" string="Payroll" groups="dct_security_management.group_finance"/></div><field name="image_1920" widget="image" class="oe_avatar"/><h1><field name="name"/></h1><group><group><field name="is_security_guard"/><field name="guard_code" required="is_security_guard"/><field name="company_id"/><field name="security_rank"/><field name="security_supervisor_id"/></group><group><field name="work_phone"/><field name="work_email"/><field name="security_eligible"/><field name="security_status"/><field name="active"/></group></group><field name="security_site_ids" widget="many2many_tags"/><notebook><page string="Qualifications"><field name="qualification_ids" context="{'default_company_id':company_id}"><list editable="bottom"><field name="qualification_id"/><field name="expiry_date"/><field name="certificate_name" groups="dct_security_management.group_hr"/><field name="certificate" filename="certificate_name" groups="dct_security_management.group_hr"/></list></field></page></notebook></sheet></form></field></record>
    <record id="action_guard" model="ir.actions.act_window"><field name="name">Guards</field><field name="res_model">hr.employee</field><field name="view_mode">list,kanban,form</field><field name="view_id" ref="view_guard_list"/><field name="search_view_id" ref="view_guard_search"/><field name="domain">[('is_security_guard','=',True)]</field><field name="context">{'default_is_security_guard':True}</field></record>
    <record id="action_guard_form" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">form</field><field name="view_id" ref="view_guard_form"/><field name="act_window_id" ref="action_guard"/></record>
    <record id="action_guard_kanban" model="ir.actions.act_window.view"><field name="sequence">10</field><field name="view_mode">kanban</field><field name="view_id" ref="view_guard_kanban"/><field name="act_window_id" ref="action_guard"/></record>
    <record id="action_qualification" model="ir.actions.act_window"><field name="name">Qualification Types</field><field name="res_model">dct.security.qualification</field><field name="view_mode">list,form</field></record>
    <record id="action_guard_qualification" model="ir.actions.act_window"><field name="name">Qualifications and Expiry</field><field name="res_model">dct.security.guard.qualification</field><field name="view_mode">list,form</field></record>
    <record id="view_security_company" model="ir.ui.view"><field name="name">dct.security.company.form</field><field name="model">res.company</field><field name="arch" type="xml"><form string="Security Operations Policy"><sheet><h1><field name="name" readonly="1"/></h1><group string="Live attendance"><field name="dct_grace_minutes"/><field name="dct_max_open_hours"/></group><group string="Automation"><field name="dct_automation_enabled"/><field name="dct_reminder_days"/></group><group string="Site map provider"><field name="dct_map_tile_url"/><field name="dct_map_attribution"/><div class="text-muted" colspan="2">Map tiles are requested by each browser from the configured provider. Confirm its licensing, attribution, privacy and usage limits before enabling. An offline site list is always available.</div></group></sheet></form></field></record>
    <record id="action_security_company" model="ir.actions.act_window"><field name="name">Company Policies</field><field name="res_model">res.company</field><field name="view_mode">form</field><field name="view_id" ref="view_security_company"/><field name="domain">[('id','in',allowed_company_ids)]</field></record>
</odoo>
