<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shift_list" model="ir.ui.view"><field name="name">dct.security.shift.list</field><field name="model">dct.security.shift</field><field name="arch" type="xml"><list decoration-warning="missing_guards &gt; 0" decoration-muted="state == 'cancelled'"><field name="name"/><field name="site_id"/><field name="post_id"/><field name="start"/><field name="end"/><field name="required_guards"/><field name="assigned_guards"/><field name="missing_guards"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_shift_calendar" model="ir.ui.view"><field name="name">dct.security.shift.calendar</field><field name="model">dct.security.shift</field><field name="arch" type="xml"><calendar date_start="start" date_stop="end" color="site_id" mode="week" quick_create="false"><field name="name"/><field name="site_id"/><field name="post_id"/><field name="required_guards"/><field name="missing_guards"/><field name="state"/></calendar></field></record>
    <record id="view_shift_search" model="ir.ui.view"><field name="name">dct.security.shift.search</field><field name="model">dct.security.shift</field><field name="arch" type="xml"><search><field name="name"/><field name="site_id"/><field name="post_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="published" string="Published" domain="[('state','=','published')]"/><filter name="date" string="Shift Date" date="start"/><group><filter name="group_site" string="Site" context="{'group_by':'site_id'}"/><filter name="group_day" string="Date" context="{'group_by':'start:day'}"/></group></search></field></record>
    <record id="view_shift_form" model="ir.ui.view"><field name="name">dct.security.shift.form</field><field name="model">dct.security.shift</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" class="oe_highlight" invisible="state != 'draft'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_copy_week" type="object" string="Copy Next Week" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><group><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="site_id" readonly="state != 'draft'"/><field name="post_id" domain="[('site_id','=',site_id)]" readonly="state != 'draft'"/><field name="start" readonly="state != 'draft'"/><field name="end" readonly="state != 'draft'"/><field name="local_date"/></group><group><field name="required_guards" readonly="state != 'draft'"/><field name="assigned_guards"/><field name="missing_guards"/><field name="break_hours" readonly="state != 'draft'"/><field name="scheduled_hours"/><field name="qualification_ids" widget="many2many_tags" readonly="state != 'draft'"/></group></group><notebook><page string="Guard Assignments"><field name="assignment_ids" context="{'default_company_id': company_id}" readonly="state != 'draft'"><list editable="bottom"><field name="employee_id" domain="[('is_security_guard','=',True),('security_eligible','=',True)]"/><field name="company_id" column_invisible="True"/><field name="override_reason" optional="hide"/><field name="state"/><field name="leave_conflict"/><field name="worked_hours"/><field name="approved_hours"/></list></field><p class="text-muted">Coverage is a requirement. Publishing a shortage keeps the shortage visible for review.</p></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_shift" model="ir.actions.act_window"><field name="name">Shifts</field><field name="res_model">dct.security.shift</field><field name="view_mode">calendar,list,form</field></record>
    <record id="view_assignment_list" model="ir.ui.view"><field name="name">dct.security.assignment.list</field><field name="model">dct.security.assignment</field><field name="arch" type="xml"><list decoration-danger="leave_conflict"><field name="employee_id"/><field name="shift_id"/><field name="site_id"/><field name="start"/><field name="end"/><field name="state" widget="badge"/><field name="leave_conflict"/><field name="attendance_state" widget="badge"/><field name="scheduled_hours" sum="Scheduled"/><field name="worked_hours" sum="Worked"/><field name="approved_hours" sum="Approved"/><field name="approved_overtime_hours" sum="Approved Overtime"/></list></field></record>
    <record id="view_assignment_form" model="ir.ui.view"><field name="name">dct.security.assignment.form</field><field name="model">dct.security.assignment</field><field name="arch" type="xml"><form><header><button name="action_replace" type="object" string="Replace Guard" invisible="state != 'published'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_reconcile_attendance" type="object" string="Allocate Attendance" invisible="state != 'published'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor,dct_security_management.group_hr"/><button name="action_approve_overtime" type="object" string="Approve Overtime" invisible="state != 'published'" groups="dct_security_management.group_manager,dct_security_management.group_hr"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="company_id" groups="base.group_multi_company"/><field name="employee_id" readonly="state != 'draft'"/><field name="shift_id" readonly="state != 'draft'"/><field name="site_id"/><field name="start"/><field name="end"/><field name="override_reason" readonly="state != 'draft'" groups="dct_security_management.group_manager"/></group><group><field name="attendance_state"/><field name="leave_conflict"/><field name="scheduled_hours"/><field name="worked_hours"/><field name="approved_hours"/><field name="lateness_minutes"/><field name="early_departure_minutes"/><field name="proposed_overtime_hours"/><field name="approved_overtime_hours"/><field name="overtime_approved_by"/><field name="overtime_approved_at"/></group></group><field name="allocation_ids" context="{'default_company_id':company_id}"/><p class="text-muted">Suspected absence requires review. Overtime uses approved allocations only; native overtime is not added again.</p></sheet><chatter/></form></field></record>
    <record id="action_assignment" model="ir.actions.act_window"><field name="name">Guard Assignments</field><field name="res_model">dct.security.assignment</field><field name="view_mode">list,form</field></record>
    <record id="view_template_list" model="ir.ui.view"><field name="name">dct.security.shift.template.list</field><field name="model">dct.security.shift.template</field><field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="post_id"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="required_guards"/><field name="auto_generate"/></list></field></record>
    <record id="view_template_form" model="ir.ui.view"><field name="name">dct.security.shift.template.form</field><field name="model">dct.security.shift.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/><field name="site_id"/><field name="post_id" domain="[('site_id','=',site_id)]"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="break_hours"/><field name="required_guards"/><field name="weekday_ids"/><field name="qualification_ids" widget="many2many_tags"/><field name="auto_generate"/><field name="generate_days" invisible="not auto_generate"/></group><p class="text-muted">Times use the site timezone. End at or before start means overnight. The local start date owns the shift. Ambiguous or nonexistent daylight-saving times require an explicit shift.</p></sheet></form></field></record>
    <record id="action_template" model="ir.actions.act_window"><field name="name">Shift Templates</field><field name="res_model">dct.security.shift.template</field><field name="view_mode">list,form</field></record>
    <record id="view_generate_roster_form" model="ir.ui.view"><field name="name">dct.security.generate.roster.form</field><field name="model">dct.security.generate.roster</field><field name="arch" type="xml"><form string="Generate Draft Roster"><group><field name="template_id"/><field name="date_from"/><field name="date_to"/><field name="preview_signature" invisible="True"/></group><field name="line_ids"><list create="false" edit="false" delete="false" decoration-danger="status == 'invalid'"><field name="local_date"/><field name="start"/><field name="end"/><field name="status"/><field name="warning"/></list></field><footer><button name="action_preview" type="object" string="Preview"/><button name="action_generate" type="object" string="Generate Drafts" class="oe_highlight" invisible="not preview_signature"/><button string="Close" special="cancel"/></footer></form></field></record>
    <record id="action_generate_roster" model="ir.actions.act_window"><field name="name">Generate Draft Roster</field><field name="res_model">dct.security.generate.roster</field><field name="view_mode">form</field><field name="target">new</field></record>
    <record id="view_replace_guard_form" model="ir.ui.view"><field name="name">dct.security.replace.guard.form</field><field name="model">dct.security.replace.guard</field><field name="arch" type="xml"><form><group><field name="assignment_id" readonly="True"/><field name="employee_id" domain="[('is_security_guard','=',True),('security_eligible','=',True)]"/><field name="reason"/><field name="override_reason" groups="dct_security_management.group_manager"/></group><footer><button name="action_replace" type="object" string="Replace Guard" class="oe_highlight"/><button string="Cancel" special="cancel"/></footer></form></field></record>
</odoo>
