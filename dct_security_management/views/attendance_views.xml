<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_attendance_list" model="ir.ui.view"><field name="name">hr.attendance.security.list</field><field name="model">hr.attendance</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="check_in"/><field name="check_out"/><field name="worked_hours" sum="Native Worked Hours"/><field name="dct_company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_security_attendance_form" model="ir.ui.view"><field name="name">hr.attendance.security.form</field><field name="model">hr.attendance</field><field name="arch" type="xml"><form><sheet><group><field name="employee_id" domain="[('is_security_guard','=',True)]"/><field name="check_in"/><field name="check_out"/><field name="worked_hours"/><field name="dct_company_id" groups="base.group_multi_company"/></group><field name="dct_allocation_ids" readonly="True"/><p class="text-muted">This is actual Odoo attendance. Record real check-in and check-out events. Approved allocations require a correction request; no checkout is invented automatically.</p></sheet><chatter/></form></field></record>
    <record id="action_attendance" model="ir.actions.act_window"><field name="name">Actual Attendance</field><field name="res_model">hr.attendance</field><field name="view_mode">list,form</field><field name="domain">[('employee_id.is_security_guard','=',True)]</field></record>
    <record id="action_attendance_list_view" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_security_attendance_list"/><field name="act_window_id" ref="action_attendance"/></record>
    <record id="action_attendance_form_view" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_security_attendance_form"/><field name="act_window_id" ref="action_attendance"/></record>
    <record id="view_allocation_list" model="ir.ui.view"><field name="name">dct.security.allocation.list</field><field name="model">dct.security.allocation</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="site_id"/><field name="assignment_id"/><field name="attendance_id"/><field name="start"/><field name="end"/><field name="hours" sum="Worked Hours"/><field name="state" widget="badge"/><button name="action_approve" type="object" string="Approve" invisible="state == 'approved'" groups="dct_security_management.group_manager,dct_security_management.group_hr"/></list></field></record>
    <record id="view_allocation_form" model="ir.ui.view"><field name="name">dct.security.allocation.form</field><field name="model">dct.security.allocation</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state == 'approved'" groups="dct_security_management.group_manager,dct_security_management.group_hr"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id" groups="base.group_multi_company" readonly="state == 'approved'"/><field name="assignment_id" readonly="state == 'approved'"/><field name="employee_id"/><field name="site_id"/><field name="attendance_id" domain="[('employee_id','=',employee_id)]" readonly="state == 'approved'"/><field name="start" readonly="state == 'approved'"/><field name="end" readonly="state == 'approved'"/><field name="hours"/><field name="note" readonly="state == 'approved'"/><field name="approved_by"/><field name="approved_at"/></group></sheet></form></field></record>
    <record id="view_allocation_pivot" model="ir.ui.view"><field name="name">dct.security.allocation.pivot</field><field name="model">dct.security.allocation</field><field name="arch" type="xml"><pivot><field name="employee_id" type="row"/><field name="start" type="col" interval="month"/><field name="hours" type="measure"/></pivot></field></record>
    <record id="view_allocation_graph" model="ir.ui.view"><field name="name">dct.security.allocation.graph</field><field name="model">dct.security.allocation</field><field name="arch" type="xml"><graph><field name="start" interval="day"/><field name="hours" type="measure"/></graph></field></record>
    <record id="view_allocation_search" model="ir.ui.view"><field name="name">dct.security.allocation.search</field><field name="model">dct.security.allocation</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="site_id"/><filter name="pending" string="Pending Review" domain="[('state','=','draft')]"/><filter name="approved" string="Approved" domain="[('state','=','approved')]"/><filter name="date" string="Period" date="start"/><group><filter name="group_guard" string="Guard" context="{'group_by':'employee_id'}"/><filter name="group_site" string="Site" context="{'group_by':'site_id'}"/></group></search></field></record>
    <record id="action_allocation" model="ir.actions.act_window"><field name="name">Attendance Allocations</field><field name="res_model">dct.security.allocation</field><field name="view_mode">list,pivot,graph,form</field></record>
    <record id="view_correction_list" model="ir.ui.view"><field name="name">dct.security.attendance.correction.list</field><field name="model">dct.security.attendance.correction</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="site_id"/><field name="attendance_id"/><field name="old_check_in"/><field name="old_check_out"/><field name="new_check_in"/><field name="new_check_out"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_correction_form" model="ir.ui.view"><field name="name">dct.security.attendance.correction.form</field><field name="model">dct.security.attendance.correction</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor,dct_security_management.group_hr"/><button name="action_approve" type="object" string="Approve Correction" invisible="state != 'submitted'" groups="dct_security_management.group_manager,dct_security_management.group_hr"/><button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="dct_security_management.group_manager,dct_security_management.group_hr"/><field name="state" widget="statusbar"/></header><sheet><group readonly="state != 'draft'"><field name="company_id" groups="base.group_multi_company"/><field name="site_id"/><field name="attendance_id"/><field name="employee_id"/><field name="old_check_in"/><field name="old_check_out"/><field name="new_check_in"/><field name="new_check_out"/><field name="reason"/><field name="approved_by"/><field name="approved_at"/></group><p class="text-muted">Original events and the reason remain in this audit record. Locked or financially consumed attendance requires a separately approved adjustment.</p></sheet><chatter/></form></field></record>
    <record id="action_attendance_correction" model="ir.actions.act_window"><field name="name">Attendance Corrections</field><field name="res_model">dct.security.attendance.correction</field><field name="view_mode">list,form</field></record>
    <record id="view_attendance_period_list" model="ir.ui.view"><field name="name">dct.security.attendance.period.list</field><field name="model">dct.security.attendance.period</field><field name="arch" type="xml"><list><field name="name"/><field name="employee_id"/><field name="start"/><field name="end"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_attendance_period_form" model="ir.ui.view"><field name="name">dct.security.attendance.period.form</field><field name="model">dct.security.attendance.period</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve and Lock" class="oe_highlight" invisible="state == 'approved'" groups="dct_security_management.group_manager,dct_security_management.group_hr"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state == 'approved'"/><field name="company_id" groups="base.group_multi_company" readonly="state == 'approved'"/><field name="employee_id" readonly="state == 'approved'"/><field name="start" readonly="state == 'approved'"/><field name="end" readonly="state == 'approved'"/><field name="approved_by"/><field name="approved_at"/></group></sheet><chatter/></form></field></record>
    <record id="action_attendance_period" model="ir.actions.act_window"><field name="name">Attendance Period Locks</field><field name="res_model">dct.security.attendance.period</field><field name="view_mode">list,form</field></record>
    <record id="view_attendance_exception_list" model="ir.ui.view"><field name="name">dct.security.attendance.exception.list</field><field name="model">dct.security.attendance.exception</field><field name="arch" type="xml"><list><field name="assignment_id"/><field name="employee_id"/><field name="site_id"/><field name="kind"/><field name="state" widget="badge"/><field name="reviewed_by"/></list></field></record>
    <record id="view_attendance_exception_form" model="ir.ui.view"><field name="name">dct.security.attendance.exception.form</field><field name="model">dct.security.attendance.exception</field><field name="arch" type="xml"><form><header><button name="action_review" type="object" string="Record Review" invisible="state == 'reviewed'" groups="dct_security_management.group_manager,dct_security_management.group_hr,dct_security_management.group_supervisor"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id" groups="base.group_multi_company"/><field name="assignment_id" readonly="state == 'reviewed'"/><field name="employee_id"/><field name="site_id"/><field name="kind" readonly="state == 'reviewed'"/><field name="resolution" readonly="state == 'reviewed'"/><field name="reviewed_by"/><field name="reviewed_at"/></group></sheet><chatter/></form></field></record>
    <record id="action_attendance_exception" model="ir.actions.act_window"><field name="name">Attendance Exceptions</field><field name="res_model">dct.security.attendance.exception</field><field name="view_mode">list,form</field></record>
</odoo>
