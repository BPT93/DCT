<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incident_list" model="ir.ui.view"><field name="name">dct.security.incident.list</field><field name="model">dct.security.incident</field><field name="arch" type="xml">
        <list decoration-danger="severity == 'critical' and state not in ['closed','resolved']"><field name="name"/><field name="occurred_at"/><field name="site_id"/><field name="category_id"/><field name="severity" widget="badge"/><field name="investigator_id"/><field name="deadline"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list>
    </field></record>
    <record id="view_incident_search" model="ir.ui.view"><field name="name">dct.security.incident.search</field><field name="model">dct.security.incident</field><field name="arch" type="xml"><search><field name="name"/><field name="site_id"/><field name="guard_ids"/><field name="category_id"/><filter name="open" string="Open" domain="[('state','not in',['resolved','closed'])]"/><filter name="critical" string="Critical" domain="[('severity','=','critical')]"/><filter name="occurred" string="Occurred" date="occurred_at"/><group><filter name="site" string="Site" context="{'group_by':'site_id'}"/><filter name="severity" string="Severity" context="{'group_by':'severity'}"/></group></search></field></record>
    <record id="view_incident_form" model="ir.ui.view"><field name="name">dct.security.incident.form</field><field name="model">dct.security.incident</field><field name="arch" type="xml">
        <form><header>
            <button name="action_acknowledge" type="object" string="Acknowledge" class="oe_highlight" invisible="state != 'new'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/>
            <button name="action_investigate" type="object" string="Investigate" class="oe_highlight" invisible="state != 'acknowledged'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/>
            <button name="action_resolve" type="object" string="Resolve" class="oe_highlight" invisible="state != 'investigating'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/>
            <button name="action_close" type="object" string="Close" invisible="state != 'resolved'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/>
            <button name="action_reopen" type="object" string="Reopen" invisible="state not in ['resolved','closed']" groups="dct_security_management.group_manager"/>
            <field name="state" widget="statusbar" statusbar_visible="new,acknowledged,investigating,resolved,closed"/>
        </header><sheet><h1><field name="name"/></h1><group><group><field name="site_id"/><field name="post_id" domain="[('site_id','=',site_id)]"/><field name="category_id"/><field name="severity"/><field name="guard_ids" widget="many2many_tags" domain="[('is_security_guard','=',True),('company_id','=',company_id)]"/></group><group><field name="occurred_at"/><field name="reported_at"/><field name="reporter_id"/><field name="investigator_id"/><field name="deadline"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Incident"><field name="description"/><group><field name="corrective_actions"/><field name="resolution"/><field name="reopen_reason" invisible="state not in ['resolved','closed']" groups="dct_security_management.group_manager"/></group></page></notebook></sheet><chatter/></form>
    </field></record>
    <record id="view_incident_pivot" model="ir.ui.view"><field name="name">dct.security.incident.pivot</field><field name="model">dct.security.incident</field><field name="arch" type="xml"><pivot><field name="site_id" type="row"/><field name="severity" type="col"/></pivot></field></record>
    <record id="action_incident" model="ir.actions.act_window"><field name="name">Incidents</field><field name="res_model">dct.security.incident</field><field name="view_mode">list,form,pivot,graph</field><field name="context">{'search_default_open':1}</field></record>
    <record id="action_incident_category" model="ir.actions.act_window"><field name="name">Incident Categories</field><field name="res_model">dct.security.incident.category</field><field name="view_mode">list,form</field></record>

    <record id="view_route_list" model="ir.ui.view"><field name="name">dct.security.patrol.route.list</field><field name="model">dct.security.patrol.route</field><field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_route_form" model="ir.ui.view"><field name="name">dct.security.patrol.route.form</field><field name="model">dct.security.patrol.route</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="site_id"/><field name="active"/><field name="company_id" groups="base.group_multi_company"/><field name="instructions"/></group><field name="checkpoint_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="required"/><field name="window_start_minutes"/><field name="window_end_minutes"/><field name="instructions"/></list></field><p class="text-muted">Timing windows are minutes after the planned start. Starting a patrol copies this route and its checkpoints into a historical snapshot.</p></sheet></form></field></record>
    <record id="action_route" model="ir.actions.act_window"><field name="name">Patrol Routes</field><field name="res_model">dct.security.patrol.route</field><field name="view_mode">list,form</field></record>
    <record id="view_patrol_result_form" model="ir.ui.view"><field name="name">dct.security.patrol.result.form</field><field name="model">dct.security.patrol.result</field><field name="arch" type="xml"><form create="false" delete="false"><header><button name="action_complete" type="object" string="Record Completion" class="oe_highlight" invisible="state != 'pending'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_approve_exception" type="object" string="Approve Exception" invisible="state != 'pending'" groups="dct_security_management.group_manager"/><field name="state" widget="statusbar"/></header><sheet><div class="alert alert-info" role="status">Manual backend entry. This is not GPS-verified or scanned evidence.</div><group><group><field name="round_id" readonly="1"/><field name="name"/><field name="sequence"/><field name="required"/><field name="instructions"/><field name="window_start_minutes"/><field name="window_end_minutes"/></group><group><field name="completed_at"/><field name="actor_id"/><field name="entry_source"/><field name="outside_window"/><field name="exception_approved_by"/><field name="exception_approved_at"/></group></group><group><field name="notes" readonly="state != 'pending'"/><field name="evidence" filename="evidence_name" readonly="state != 'pending'"/><field name="evidence_name" invisible="1"/><field name="exception_reason" readonly="state != 'pending'"/></group></sheet></form></field></record>
    <record id="view_patrol_list" model="ir.ui.view"><field name="name">dct.security.patrol.round.list</field><field name="model">dct.security.patrol.round</field><field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="route_id"/><field name="employee_id"/><field name="planned_start"/><field name="planned_end"/><field name="completion_percent" widget="progressbar"/><field name="missed_count"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_patrol_form" model="ir.ui.view"><field name="name">dct.security.patrol.round.form</field><field name="model">dct.security.patrol.round</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Patrol" class="oe_highlight" invisible="state != 'draft'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_close" type="object" string="Close Round" class="oe_highlight" invisible="state != 'running'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'" groups="dct_security_management.group_manager"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><group><field name="route_id" readonly="state != 'draft'"/><field name="site_id" readonly="state != 'draft'"/><field name="assignment_id" domain="[('site_id','=',site_id),('state','=','published')]" readonly="state != 'draft'"/><field name="employee_id" domain="[('is_security_guard','=',True)]" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="planned_start" readonly="state != 'draft'"/><field name="planned_end" readonly="state != 'draft'"/><field name="actual_start"/><field name="actual_end"/><field name="completion_percent" widget="progressbar"/><field name="missed_count"/></group></group><div class="alert alert-info" role="status">Open a checkpoint to record completion, attach evidence, or request an exception. All results are manual backend entries.</div><field name="instructions_snapshot"/><field name="result_ids" readonly="1"><list create="false" delete="false"><field name="sequence"/><field name="name"/><field name="required"/><field name="state" widget="badge"/><field name="completed_at"/><field name="actor_id"/><field name="outside_window"/><button name="action_open" type="object" string="Open Checkpoint" icon="fa-pencil"/></list></field></sheet><chatter/></form></field></record>
    <record id="view_patrol_search" model="ir.ui.view"><field name="name">dct.security.patrol.round.search</field><field name="model">dct.security.patrol.round</field><field name="arch" type="xml"><search><field name="name"/><field name="site_id"/><field name="employee_id"/><filter name="open" string="Open" domain="[('state','in',['draft','running'])]"/><filter name="period" string="Planned Start" date="planned_start"/><group><filter name="site" string="Site" context="{'group_by':'site_id'}"/><filter name="state" string="Status" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="action_patrol" model="ir.actions.act_window"><field name="name">Patrol Rounds</field><field name="res_model">dct.security.patrol.round</field><field name="view_mode">list,form,pivot,graph</field></record>

    <record id="view_inspection_template_form" model="ir.ui.view"><field name="name">dct.security.inspection.template.form</field><field name="model">dct.security.inspection.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group><field name="item_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="required"/></list></field></sheet></form></field></record>
    <record id="action_inspection_template" model="ir.actions.act_window"><field name="name">Inspection Checklists</field><field name="res_model">dct.security.inspection.template</field><field name="view_mode">list,form</field></record>
    <record id="view_visit_result_form" model="ir.ui.view"><field name="name">dct.security.visit.result.form</field><field name="model">dct.security.visit.result</field><field name="arch" type="xml"><form create="false" delete="false"><sheet><group><field name="visit_id" readonly="1"/><field name="name"/><field name="required"/><field name="result"/><field name="notes"/><field name="actor_id"/><field name="recorded_at"/></group></sheet></form></field></record>
    <record id="view_visit_list" model="ir.ui.view"><field name="name">dct.security.visit.list</field><field name="model">dct.security.visit</field><field name="arch" type="xml"><list><field name="name"/><field name="site_id"/><field name="supervisor_id"/><field name="planned_at"/><field name="actual_start"/><field name="actual_end"/><field name="incident_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_visit_form" model="ir.ui.view"><field name="name">dct.security.visit.form</field><field name="model">dct.security.visit</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Inspection" class="oe_highlight" invisible="state != 'planned'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_complete" type="object" string="Complete Visit" class="oe_highlight" invisible="state != 'in_progress'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_cancel" type="object" string="Cancel" invisible="state != 'planned'" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><button name="action_create_incident" type="object" string="Incident from Findings" groups="dct_security_management.group_manager,dct_security_management.group_supervisor"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><group><field name="site_id" readonly="state != 'planned'"/><field name="supervisor_id" readonly="state != 'planned'"/><field name="template_id" readonly="state != 'planned'"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="planned_at" readonly="state != 'planned'"/><field name="actual_start"/><field name="actual_end"/><field name="incident_id"/><field name="incident_category_id" readonly="state in ['done','cancelled']"/></group></group><notebook><page string="Inspection"><field name="result_ids" readonly="1"><list create="false" delete="false"><field name="sequence"/><field name="name"/><field name="required"/><field name="result"/><field name="notes"/><field name="actor_id"/><field name="recorded_at"/><button name="action_open" type="object" string="Record Findings" icon="fa-pencil"/></list></field><p class="text-muted">Open each checklist item to record its result and findings.</p></page><page string="Findings"><group><field name="findings" readonly="state in ['done','cancelled']"/><field name="followup_actions" readonly="state in ['done','cancelled']"/><field name="photo" widget="image" readonly="state in ['done','cancelled']"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_visit" model="ir.actions.act_window"><field name="name">Supervisor Visits</field><field name="res_model">dct.security.visit</field><field name="view_mode">list,form,pivot,graph</field></record>
</odoo>
