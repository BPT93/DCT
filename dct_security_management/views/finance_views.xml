<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billing_list" model="ir.ui.view"><field name="name">dct.security.billing.list</field><field name="model">dct.security.billing</field><field name="arch" type="xml"><list><field name="contract_id"/><field name="partner_id"/><field name="date_start"/><field name="date_end"/><field name="currency_id"/><field name="amount_total" string="Untaxed approved estimate"/><field name="state" widget="badge"/><field name="invoice_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_billing_form" model="ir.ui.view"><field name="name">dct.security.billing.form</field><field name="model">dct.security.billing</field><field name="arch" type="xml"><form>
        <header><button name="action_prepare" type="object" string="Calculate" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/><button name="action_create_invoice" type="object" string="Create / Open Invoice" class="oe_highlight" invisible="state not in ('approved','invoiced')"/><button name="action_cancel" type="object" string="Cancel Review" invisible="state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,approved,invoiced"/></header>
        <sheet><h1><field name="name"/></h1><group><group><field name="contract_id" readonly="state != 'draft'"/><field name="partner_id"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id"/></group><group><field name="date_start" readonly="state != 'draft'"/><field name="date_end" readonly="state != 'draft'"/><field name="invoice_id"/><field name="approved_by"/><field name="approved_at"/></group></group>
        <notebook><page string="Approved service quantities"><p>Actual hours include approved allocations only. Dates use each site's timezone; shift quantities belong to the shift's local start date. Invoices remain drafts for the normal accounting review.</p><field name="line_ids" readonly="1"><list><field name="name"/><field name="site_id"/><field name="date_start"/><field name="date_end"/><field name="billing_basis"/><field name="quantity"/><field name="rate"/><field name="subtotal"/><field name="currency_id" column_invisible="True"/></list><form><group><field name="name"/><field name="contract_line_id"/><field name="site_id"/><field name="date_start"/><field name="date_end"/><field name="billing_basis"/><field name="quantity"/><field name="rate"/><field name="currency_id"/><field name="subtotal"/><field name="product_id"/><field name="account_id"/><field name="tax_ids" widget="many2many_tags"/><field name="allocation_ids" widget="many2many_tags"/></group></form></field></page><page string="Authorized deductions"><group><field name="discount_percent" readonly="state != 'draft'"/><field name="deduction_amount" readonly="state != 'draft'"/><field name="deduction_product_id" readonly="state != 'draft'"/><field name="adjustment_reason" readonly="state != 'draft'"/></group></page><page string="Cancellation and rebilling"><p>A cancelled invoice or exact full posted credit note releases this period for a new review. Partial credits keep the period reserved.</p><field name="cancellation_reason"/></page></notebook><group class="oe_subtotal_footer"><field name="amount_total" string="Untaxed approved estimate"/></group></sheet><chatter/>
    </form></field></record>
    <record id="action_billing" model="ir.actions.act_window"><field name="name">Contract Billing</field><field name="res_model">dct.security.billing</field><field name="view_mode">list,form</field></record>

    <record id="view_compensation_list" model="ir.ui.view"><field name="name">dct.security.compensation.list</field><field name="model">dct.security.compensation</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="date_start"/><field name="date_end"/><field name="basis"/><field name="currency_id"/><field name="rate"/><field name="overtime_rate"/><field name="allowance"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_compensation_form" model="ir.ui.view"><field name="name">dct.security.compensation.form</field><field name="model">dct.security.compensation</field><field name="arch" type="xml"><form><sheet><h1>Effective Compensation</h1><group><group><field name="employee_id" domain="[('is_security_guard','=',True)]"/><field name="company_id" groups="base.group_multi_company"/><field name="date_start"/><field name="date_end"/><field name="currency_id"/></group><group><field name="basis"/><field name="rate"/><field name="monthly_hours"/><field name="estimated_hourly_cost"/><field name="overtime_rate"/><field name="allowance"/></group></group><separator string="Optional draft accounting entry"/><group><field name="journal_id"/><field name="expense_account_id"/><field name="payable_account_id"/></group><field name="notes"/><p>Monthly rates and allowances use calendar day proration. Approved worksheets freeze their settings. Split worksheets at compensation effective-date changes.</p></sheet><chatter/></form></field></record>
    <record id="action_compensation" model="ir.actions.act_window"><field name="name">Guard Compensation</field><field name="res_model">dct.security.compensation</field><field name="view_mode">list,form</field></record>

    <record id="view_payroll_list" model="ir.ui.view"><field name="name">dct.security.payroll.list</field><field name="model">dct.security.payroll</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="date_start"/><field name="date_end"/><field name="approved_hours"/><field name="currency_id"/><field name="gross_amount"/><field name="allowance_amount"/><field name="deduction_amount"/><field name="net_amount"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_payroll_form" model="ir.ui.view"><field name="name">dct.security.payroll.form</field><field name="model">dct.security.payroll</field><field name="arch" type="xml"><form>
        <header><button name="action_calculate" type="object" string="Calculate" invisible="state != 'draft'"/><button name="action_review" type="object" string="Review" class="oe_highlight" invisible="state != 'draft'"/><button name="action_draft" type="object" string="Return to Draft" invisible="state != 'reviewed'"/><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'reviewed'"/><button name="action_export" type="object" string="Export CSV" invisible="state not in ('approved','exported','accounted')"/><button name="action_create_entry" type="object" string="Create / Open Draft Entry" invisible="state not in ('approved','exported','accounted')"/><field name="state" widget="statusbar" statusbar_visible="draft,reviewed,approved,exported,accounted"/></header>
        <sheet><div class="alert alert-info" role="alert">Operational payroll estimate. Approval does not pay wages. Statutory taxes and contributions require a payroll localization or an existing compatible payroll system.</div><h1><field name="name"/></h1><group><group><field name="employee_id" domain="[('is_security_guard','=',True)]" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="date_start" readonly="state != 'draft'"/><field name="date_end" readonly="state != 'draft'"/><field name="currency_id" readonly="state != 'draft'"/></group><group><field name="compensation_id"/><field name="approved_hours"/><field name="overtime_hours"/><field name="approved_by"/><field name="approved_at"/><field name="move_id"/></group></group>
        <notebook><page string="Calculation"><field name="line_ids" readonly="1"><list><field name="name"/><field name="kind"/><field name="site_id"/><field name="quantity"/><field name="rate"/><field name="amount"/><field name="currency_id" column_invisible="True"/></list></field><group class="oe_subtotal_footer"><field name="gross_amount"/><field name="allowance_amount"/><field name="net_amount"/></group></page><page string="Approved attendance"><p>Only approved allocations enter the calculation. Native attendance overtime is not added separately. Monthly salary remains a prorated estimate; leave and suspected absence never cause automatic deductions.</p><field name="allocation_ids" readonly="1"><list><field name="employee_id"/><field name="site_id"/><field name="start"/><field name="end"/><field name="hours"/><field name="state"/></list></field></page><page string="Explicit adjustments"><group><field name="allowance_adjustment" readonly="state != 'draft'"/><field name="deduction_amount" readonly="state != 'draft'"/><field name="adjustment_amount" readonly="state != 'draft'"/><field name="adjustment_of_id" readonly="state != 'draft'"/><field name="adjustment_reason" readonly="state != 'draft'"/></group><field name="notes" readonly="state != 'draft'"/></page><page string="Export"><field name="export_file" filename="export_filename"/><field name="export_filename" invisible="1"/></page></notebook></sheet><chatter/>
    </form></field></record>
    <record id="view_payroll_pivot" model="ir.ui.view"><field name="name">dct.security.payroll.pivot</field><field name="model">dct.security.payroll</field><field name="arch" type="xml"><pivot string="Estimated Payroll Costs"><field name="currency_id" type="row"/><field name="employee_id" type="row"/><field name="date_start" type="col" interval="month"/><field name="approved_hours" type="measure"/></pivot></field></record>
    <record id="action_payroll" model="ir.actions.act_window"><field name="name">Payroll Worksheets</field><field name="res_model">dct.security.payroll</field><field name="view_mode">list,form,pivot</field></record>
</odoo>
