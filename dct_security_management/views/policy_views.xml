<odoo>
    <record id="view_security_company_work_policy" model="ir.ui.view"><field name="name">dct.security.company.work.policy</field><field name="model">res.company</field><field name="inherit_id" ref="view_security_company"/><field name="arch" type="xml"><xpath expr="//sheet/group[1]" position="after"><group string="Planning and attendance policies"><field name="dct_rest_hours"/><field name="dct_max_shift_hours"/><field name="dct_absence_grace_minutes"/><field name="dct_checkout_grace_hours"/></group></xpath></field></record>
    <record id="view_guard_supervisor_flag" model="ir.ui.view"><field name="name">dct.guard.supervisor.flag</field><field name="model">hr.employee</field><field name="inherit_id" ref="view_guard_form"/><field name="arch" type="xml"><field name="is_security_guard" position="after"><field name="is_security_supervisor"/></field></field></record>
    <record id="action_security_supervisors" model="ir.actions.act_window"><field name="name">Operational Supervisors</field><field name="res_model">hr.employee</field><field name="view_mode">list,form</field><field name="view_id" ref="view_guard_list"/><field name="domain">[('is_security_supervisor','=',True)]</field><field name="context">{'default_is_security_supervisor':True}</field></record>
    <record id="action_security_supervisor_form" model="ir.actions.act_window.view"><field name="view_mode">form</field><field name="view_id" ref="view_guard_form"/><field name="act_window_id" ref="action_security_supervisors"/></record>
    <menuitem id="menu_security_supervisors" name="Operational Supervisors" parent="menu_configuration" action="action_security_supervisors" groups="group_manager,group_hr" sequence="65"/>
</odoo>
