<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_list" model="ir.ui.view">
        <field name="name">dct.security.contract.list</field><field name="model">dct.security.contract</field>
        <field name="arch" type="xml"><list decoration-muted="state in ('expired', 'cancelled')"><field name="name"/><field name="partner_id"/><field name="site_ids" widget="many2many_tags"/><field name="date_start"/><field name="date_end"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field>
    </record>
    <record id="view_contract_search" model="ir.ui.view">
        <field name="name">dct.security.contract.search</field><field name="model">dct.security.contract</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="site_ids"/><filter name="active_contracts" string="Active" domain="[('state','=','active')]"/><filter name="expired_contracts" string="Expired" domain="[('state','=','expired')]"/><group><filter name="by_customer" string="Customer" context="{'group_by':'partner_id'}"/></group></search></field>
    </record>
    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">dct.security.contract.form</field><field name="model">dct.security.contract</field>
        <field name="arch" type="xml"><form>
            <header><button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state not in ('draft','suspended')" groups="dct_security_management.group_manager"/><button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'" groups="dct_security_management.group_manager"/><button name="action_expire" type="object" string="Expire" invisible="state not in ('active','suspended')" groups="dct_security_management.group_manager"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled','expired')" groups="dct_security_management.group_manager"/><button name="action_new_billing" type="object" string="New Billing Review" invisible="state != 'active'" groups="dct_security_management.group_finance"/><field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,expired"/></header>
            <sheet><div class="oe_title"><h1><field name="name" placeholder="Service contract reference"/></h1></div>
                <group><group><field name="partner_id" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="site_ids" widget="many2many_tags" domain="[('partner_id','=',partner_id)]" readonly="state != 'draft'"/></group><group><field name="date_start" readonly="state != 'draft'"/><field name="date_end" readonly="state != 'draft'"/><field name="currency_id" readonly="state != 'draft'"/><field name="billing_cycle" readonly="state != 'draft'"/><field name="payment_term_id" readonly="state != 'draft'" groups="dct_security_management.group_finance"/><field name="auto_billing" groups="dct_security_management.group_finance"/></group></group>
                <notebook><page string="Service and coverage"><p>Effective service lines preserve historical rates and coverage. Add future non-overlapping terms, or create a successor contract.</p><field name="line_ids" context="{'default_date_start': date_start, 'default_date_end': date_end}"><list><field name="name"/><field name="site_id"/><field name="post_id"/><field name="date_start"/><field name="date_end"/><field name="required_guards"/><field name="billing_basis"/><field name="quantity"/><field name="currency_id" column_invisible="True"/><field name="rate" groups="dct_security_management.group_finance"/></list><form><group><group><field name="name"/><field name="site_id"/><field name="post_id" domain="[('site_id','=',site_id)]"/><field name="date_start"/><field name="date_end"/><field name="required_guards"/></group><group><field name="product_id"/><field name="billing_basis"/><field name="quantity"/><field name="currency_id" invisible="1"/><field name="rate" groups="dct_security_management.group_finance"/><field name="proration" invisible="billing_basis != 'fixed'"/><field name="account_id" groups="dct_security_management.group_finance"/><field name="tax_ids" widget="many2many_tags" groups="dct_security_management.group_finance"/></group></group></form></field></page><page string="Instructions and documents"><field name="notes"/></page><page string="Billing history" groups="dct_security_management.group_finance"><field name="billing_ids" readonly="1"><list><field name="date_start"/><field name="date_end"/><field name="state"/><field name="currency_id" column_invisible="True"/><field name="amount_total"/><field name="invoice_id"/></list></field></page></notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_contract" model="ir.actions.act_window"><field name="name">Contracts</field><field name="res_model">dct.security.contract</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Define a customer service contract</p><p>Add sites, effective coverage and configured billing terms before activation.</p></field></record>
</odoo>
