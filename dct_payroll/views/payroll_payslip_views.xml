<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_view_list_enterprise" model="ir.ui.view">
        <field name="name">hr.payslip.list.enterprise</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list
                    string="Employee Payslips"
                    create="0"
                    multi_edit="1"
                    sample="1"
                    decoration-muted="dct_status == 'cancel'"
                >
                    <header>
                        <button
                            name="action_open_new_off_cycle"
                            type="object"
                            string="New Off-Cycle"
                            display="always"
                            class="btn-primary"
                        />
                        <button
                            name="action_open_new_pay_run"
                            type="object"
                            string="Pay Run"
                            display="always"
                        />
                    </header>
                    <field name="number" string="Reference" readonly="1" decoration-bf="1"/>
                    <field name="employee_id" readonly="1"/>
                    <field name="payslip_run_id" string="Pay Run" optional="show"/>
                    <field
                        name="company_id"
                        optional="show"
                        groups="base.group_multi_company"
                        options="{'no_create': True}"
                    />
                    <field name="date_from" string="Period Start" optional="hide"/>
                    <field name="date_to" string="Period End" optional="hide"/>
                    <field name="basic_wage" sum="Total Basic" optional="show"/>
                    <field name="gross_pay" sum="Total Gross" optional="show"/>
                    <field name="net_pay" sum="Total Net" optional="show"/>
                    <field name="dct_status" widget="badge" optional="show"
                        decoration-info="dct_status == 'draft'"
                        decoration-warning="dct_status == 'verify'"
                        decoration-primary="dct_status == 'done'"
                        decoration-success="dct_status == 'paid'"
                        decoration-danger="dct_status == 'cancel'"
                    />
                    <field name="currency_id" column_invisible="True"/>
                    <field name="state" column_invisible="True"/>
                    <field name="paid" column_invisible="True"/>
                    <field name="activity_ids" widget="list_activity" optional="hide"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_view_form_enterprise" model="ir.ui.view">
        <field name="name">hr.payslip.form.enterprise</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form string="Employee Payslip" class="o_dct_payslip_form">
                    <header>
                        <button
                            string="Compute Sheet"
                            name="compute_sheet"
                            type="object"
                            invisible="state not in ('draft', 'verify')"
                            class="oe_highlight"
                        />
                        <button
                            string="Create Draft Entry"
                            name="action_create_draft_entry"
                            type="object"
                            invisible="state != 'verify'"
                            class="oe_highlight"
                        />
                        <button
                            string="Payment Report"
                            name="action_download_payment_report"
                            type="object"
                            invisible="state != 'done'"
                        />
                        <button
                            string="Mark as Paid"
                            name="action_mark_paid"
                            type="object"
                            invisible="state != 'done' or paid"
                            class="oe_highlight"
                        />
                        <button
                            string="Print"
                            name="%(payroll.action_report_payslip)d"
                            type="action"
                            invisible="state not in ('verify', 'done')"
                        />
                        <button
                            string="Refund"
                            name="refund_sheet"
                            type="object"
                            invisible="state != 'done'"
                        />
                        <button
                            string="Revert"
                            name="action_payslip_draft"
                            type="object"
                            invisible="state not in ('verify', 'cancel')"
                        />
                        <button
                            string="Cancel"
                            name="action_payslip_cancel"
                            type="object"
                            invisible="state not in ('draft', 'verify')"
                        />
                        <button
                            string="Cancel"
                            name="action_payslip_cancel"
                            type="object"
                            invisible="state != 'done' or not allow_cancel_payslips"
                        />
                        <field name="dct_status" widget="statusbar"
                            statusbar_visible="draft,verify,done,paid"/>
                    </header>
                    <sheet>
                        <field name="state" invisible="1"/>
                        <field name="paid" invisible="1"/>
                        <field name="allow_cancel_payslips" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button
                                name="action_open_journal_entry"
                                class="oe_stat_button"
                                icon="fa-book"
                                type="object"
                                invisible="not move_id and state != 'done'"
                            >
                                <span class="o_stat_text">Journal Entry</span>
                            </button>
                            <button
                                name="%(payroll.hr_payslip_line_action_computation_details)d"
                                class="oe_stat_button"
                                icon="fa-money"
                                type="action"
                            >
                                <field name="payslip_count" widget="statinfo" string="Payslip Lines"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Employee Payslip"/>
                            <h1>
                                <field name="name" placeholder="Employee Payslip" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group name="payslip_details">
                            <group name="employee_details">
                                <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field
                                    name="contract_id"
                                    required="1"
                                    readonly="state != 'draft'"
                                    domain="[('employee_id', '=', employee_id), ('date_start', '&lt;=', date_to), '|', ('date_end', '&gt;=', date_from), ('date_end', '=', False)]"
                                    context="{'default_employee_id': employee_id}"
                                    options="{'no_create': True}"
                                />
                                <field
                                    name="payslip_run_id"
                                    string="Pay Run"
                                    readonly="state != 'draft'"
                                    domain="[('state', '=', 'draft')]"
                                    options="{'no_create': True}"
                                />
                                <field name="struct_id" required="1" readonly="state != 'draft'" force_save="1" options="{'no_create': True}"/>
                            </group>
                            <group name="period_details">
                                <label for="date_from" string="Period"/>
                                <div>
                                    <field
                                        name="date_from"
                                        widget="daterange"
                                        class="oe_inline"
                                        options="{'end_date_field': 'date_to'}"
                                        readonly="state != 'draft'"
                                    />
                                </div>
                                <field name="date_to" invisible="1"/>
                                <field name="number" string="Reference" readonly="1"/>
                                <field name="credit_note" readonly="state != 'draft'"/>
                                <field name="compute_date" readonly="1" invisible="not compute_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="input" string="Worked Days &amp; Inputs">
                                <separator name="worked" string="Worked Days"/>
                                <field name="worked_days_line_ids" nolabel="1" readonly="state != 'draft'">
                                    <list create="false" delete="false">
                                        <field name="code" string="Type"/>
                                        <field name="name" string="Description"/>
                                        <field name="number_of_days" string="Number of Days"/>
                                        <field name="number_of_hours" string="Number of Hours"/>
                                        <field name="contract_id" column_invisible="True"/>
                                        <field name="sequence" column_invisible="True"/>
                                    </list>
                                </field>
                                <separator name="other" string="Other Inputs"/>
                                <field name="input_line_ids" nolabel="1" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="dct_input_type_id" string="Type" options="{'no_create': True}"/>
                                        <field name="name" string="Description"/>
                                        <field name="amount" string="Count"/>
                                        <field name="code" column_invisible="True"/>
                                        <field name="amount_qty" column_invisible="True"/>
                                        <field name="contract_id" column_invisible="True"/>
                                        <field name="sequence" column_invisible="True"/>
                                    </list>
                                </field>
                            </page>
                            <page name="computation" string="Salary Computation">
                                <field name="dynamic_filtered_payslip_lines" nolabel="1" colspan="4">
                                    <list
                                        create="false"
                                        delete="false"
                                        decoration-info="total == 0 and appears_on_payslip"
                                        decoration-bf="not parent_rule_id"
                                        decoration-it="parent_rule_id"
                                        decoration-muted="parent_rule_id or not appears_on_payslip"
                                    >
                                        <field name="appears_on_payslip" column_invisible="True"/>
                                        <field name="parent_rule_id" column_invisible="True"/>
                                        <field name="code" readonly="1" optional="show"/>
                                        <field name="category_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="quantity" readonly="1" optional="hide"/>
                                        <field name="rate" readonly="1" optional="hide"/>
                                        <field name="amount" readonly="1"/>
                                        <field name="total" readonly="1" sum="Total"
                                            decoration-danger="total &lt; 0 and not parent_rule_id"
                                            decoration-success="total &gt; 0 and not parent_rule_id"
                                        />
                                    </list>
                                </field>
                                <group class="mt-3">
                                    <group/>
                                    <group string="Payslip Totals">
                                        <field name="basic_wage" readonly="1"/>
                                        <field name="gross_pay" readonly="1"/>
                                        <field name="net_pay" readonly="1"/>
                                        <field name="employer_cost" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page name="other_info" string="Other Info">
                                <group>
                                    <group string="Payslip">
                                        <field name="name" string="Payslip Name" readonly="state != 'draft'"/>
                                        <field name="company_id" readonly="1" options="{'no_create': True}"/>
                                        <field name="close_date" readonly="state != 'draft'"/>
                                        <field name="date" string="Date Account" readonly="state != 'draft'"/>
                                    </group>
                                    <group string="Accounting">
                                        <field name="journal_id" string="Salary Journal" readonly="state != 'draft'" options="{'no_create': True}"/>
                                        <field name="move_id" string="Accounting Entry" readonly="1"/>
                                        <field name="paid" string="Paid" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="note" placeholder="Add an Internal Note…" nolabel="1" readonly="state != 'draft'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_view_search_enterprise" model="ir.ui.view">
        <field name="name">hr.payslip.search.enterprise</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_search"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="replace">
                <search string="Search Payslips">
                    <field name="employee_id"/>
                    <field name="name" string="Reference or Payslip"
                        filter_domain="['|', ('name', 'ilike', self), ('number', 'ilike', self)]"/>
                    <field name="payslip_run_id" string="Pay Run"/>
                    <field name="department_id"/>
                    <field name="struct_id" string="Salary Structure"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Waiting" name="verify" domain="[('state', '=', 'verify')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <filter string="Paid" name="paid" domain="[('state', '=', 'done'), ('paid', '=', True)]"/>
                    <filter string="Rejected" name="cancel" domain="[('state', '=', 'cancel')]"/>
                    <separator/>
                    <filter string="Last 365 Days" name="last_365_days"
                        domain="[('date_to', '&gt;=', (context_today() - relativedelta(days=365)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Period" name="period" date="date_to"/>
                    <separator/>
                    <group>
                        <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Pay Run" name="group_by_batch" context="{'group_by': 'payslip_run_id'}"/>
                        <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Salary Structure" name="group_by_structure" context="{'group_by': 'struct_id'}"/>
                        <filter string="Company" name="group_by_company" groups="base.group_multi_company" context="{'group_by': 'company_id'}"/>
                        <filter string="Status" name="group_by_status" context="{'group_by': 'dct_status'}"/>
                        <filter string="Period" name="group_by_period" context="{'group_by': 'date_to:month'}"/>
                    </group>
                </search>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_run_view_list_enterprise" model="ir.ui.view">
        <field name="name">hr.payslip.run.list.enterprise</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Pay Runs" sample="1" decoration-muted="dct_status == 'paid'">
                    <field name="name" decoration-bf="1"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="payslip_count"/>
                    <field name="employer_cost" sum="Total Employer Cost"/>
                    <field name="gross_pay" sum="Total Gross"/>
                    <field name="net_pay" sum="Total Net"/>
                    <field name="dct_status" widget="badge"
                        decoration-info="dct_status == 'ready'"
                        decoration-primary="dct_status == 'done'"
                        decoration-success="dct_status == 'paid'"
                    />
                    <field name="currency_id" column_invisible="True"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_run_view_form_enterprise" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.enterprise</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form string="Pay Run">
                    <header>
                        <button name="%(payroll.action_hr_payslip_by_employees)d" type="action"
                            string="Generate Payslips" invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_create_draft_entries" type="object"
                            string="Create Draft Entry" invisible="state != 'draft' or not slip_ids" class="oe_highlight"/>
                        <button name="action_download_payment_report" type="object"
                            string="Payment Report" invisible="state != 'close'"/>
                        <button name="action_mark_paid" type="object"
                            string="Mark as Paid" invisible="state != 'close' or dct_status == 'paid'" class="oe_highlight"/>
                        <button name="draft_payslip_run" type="object"
                            string="Revert" invisible="state != 'close' or dct_status == 'paid'"/>
                        <field name="dct_status" widget="statusbar" statusbar_visible="ready,done,paid"/>
                    </header>
                    <sheet>
                        <field name="state" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" string="Pay Run"/>
                            <h1><field name="name" readonly="state != 'draft'" placeholder="New Pay Run"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="struct_id" string="Salary Structure" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <label for="date_start" string="Period"/>
                                <div>
                                    <field name="date_start" widget="daterange" class="oe_inline"
                                        options="{'end_date_field': 'date_end'}" readonly="state != 'draft'"/>
                                </div>
                                <field name="date_end" invisible="1"/>
                            </group>
                            <group>
                                <field name="journal_id" string="Salary Journal" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                                <field name="credit_note" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group string="Totals" invisible="not slip_ids">
                            <field name="payslip_count" readonly="1"/>
                            <field name="employer_cost" readonly="1"/>
                            <field name="gross_pay" readonly="1"/>
                            <field name="net_pay" readonly="1"/>
                        </group>
                        <separator string="Payslips"/>
                        <field name="slip_ids" readonly="state != 'draft'" nolabel="1">
                            <list>
                                <field name="number" string="Reference"/>
                                <field name="employee_id"/>
                                <field name="basic_wage"/>
                                <field name="gross_pay"/>
                                <field name="net_pay"/>
                                <field name="dct_status" string="Status" widget="badge"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </xpath>
        </field>
    </record>

    <record id="payroll.hr_payslip_action" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_batch': 1}</field>
    </record>
    <record id="payroll.hr_payslip_run_action" model="ir.actions.act_window">
        <field name="name">Pay Runs</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
