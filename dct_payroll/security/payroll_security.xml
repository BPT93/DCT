<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="dct_payroll_note_company_rule" model="ir.rule">
        <field name="name">Payroll notes by company</field>
        <field name="model_id" ref="model_dct_payroll_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('payroll.group_payroll_user'))]"/>
    </record>

    <!-- Payslip lines contain the same sensitive salary information as their
         parent payslips, so mirror the OCA payslip visibility rules. -->
    <record id="hr_payslip_line_rule_officer" model="ir.rule">
        <field name="name">Payroll officer and subordinate payslip lines</field>
        <field name="model_id" ref="payroll.model_hr_payslip_line"/>
        <field name="domain_force">
            ['|', '|', ('slip_id.employee_id.user_id', '=', user.id),
            ('slip_id.employee_id.department_id', '=', False),
            ('slip_id.employee_id.department_id.manager_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('payroll.group_payroll_user'))]"/>
    </record>
    <record id="hr_payslip_line_rule_manager" model="ir.rule">
        <field name="name">Payroll managers see all payslip lines</field>
        <field name="model_id" ref="payroll.model_hr_payslip_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('payroll.group_payroll_manager'))]"/>
    </record>
    <record id="hr_payslip_line_rule_company" model="ir.rule">
        <field name="name">Payslip lines: multi-company</field>
        <field name="model_id" ref="payroll.model_hr_payslip_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|', ('slip_id.company_id', '=', False),
            ('slip_id.company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
